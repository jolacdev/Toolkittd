{
  "name": "toolkittd",
  "description": "Toolkittd is a browser extension that enhances Backloggd with extra tools, including game collection export to CSV and JSON.",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "tsc && wxt build --mv3",
    "build:firefox": "tsc && wxt build -b firefox --mv2",
    "zip": "wxt zip --mv3",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "sync:skills": "jiti scripts/sync-skills.ts",
    "tscheck": "tsc --noEmit",
    "lint": "pnpm tscheck && eslint --fix",
    "lint:errors": "pnpm tscheck && eslint --fix --quiet",
    "lint:no-fix": "pnpm tscheck && eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check:packages": "jiti scripts/workflows/ci/check-packages.ts",
    "check:firefox-sources": "jiti scripts/workflows/ci/check-firefox-sources.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.16",
    "axios": "1.15.0",
    "papaparse": "5.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.10.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "@vitest/browser": "4.0.17",
    "@vitest/ui": "4.0.17",
    "@wxt-dev/module-react": "1.1.5",
    "clsx": "2.1.1",
    "daisyui": "5.5.0",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "16.4.0",
    "i18next": "25.6.0",
    "jiti": "2.5.1",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.0",
    "publish-browser-extension": "6.1.1",
    "react-i18next": "16.0.1",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.17",
    "wxt": "0.20.26"
  }
}
